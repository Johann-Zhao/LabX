# 复制本文件为 .env 并填入真实 key（.env 已在 .gitignore 中，绝不提交）
# 选一个国内 OpenAI 兼容平台（DeepSeek / 智谱 / 通义），不要用 OpenAI 官方（国内直连不通）
LABX_API_KEY=sk-xxx
LABX_API_BASE=https://api.deepseek.com/v1
LABX_MODEL=deepseek-v4-flash-vision-exp
# 演示断网兜底：true 时 LLM 调用返回预置答案（阶段 2 的 llm.py 会读取）
LABX_LLM_MOCK=false

# Seedream 5.0 Pro（火山引擎 Ark，图像生成，阶段 4 演示图片用）
# 生图 prompt 注意：不要写"45度俯拍"这类数字角度（会被渲染成图上的文字），并加"无文字无水印"
SEEDREAM_API_KEY=ark-xxx
SEEDREAM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
